/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self' https://formsubmit.co; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self' https://formsubmit.co; upgrade-insecure-requests

/admin
  Cache-Control: no-store
  X-Robots-Tag: noindex, nofollow, noarchive

/admin.html
  Cache-Control: no-store
  X-Robots-Tag: noindex, nofollow, noarchive

/admin-content
  Cache-Control: no-store
  X-Robots-Tag: noindex, nofollow, noarchive

/admin-content.html
  Cache-Control: no-store
  X-Robots-Tag: noindex, nofollow, noarchive

/js/render.js
  Cache-Control: no-cache, no-store, must-revalidate

/js/site-data.js
  Cache-Control: no-cache, no-store, must-revalidate

/js/config.js
  Cache-Control: no-cache, no-store, must-revalidate
