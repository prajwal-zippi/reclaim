{
  "cleanUrls": true,
  "trailingSlash": false,
  "functions": {
    "api/index.js": {
      "includeFiles": "{netlify/functions/api.mjs,node_modules/@neondatabase/serverless/index.js,node_modules/@neondatabase/serverless/index.mjs,node_modules/@neondatabase/serverless/package.json}"
    }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api?path=:path" },
    { "source": "/", "destination": "/website/index" },
    { "source": "/:path((?!api(?:/|$)).*)", "destination": "/website/:path" }
  ]
}
